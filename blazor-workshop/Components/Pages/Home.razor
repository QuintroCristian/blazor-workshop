@page "/"
@rendermode InteractiveServer

@using blazor_workshop.Models


<PageTitle>Comida Paisa</PageTitle>

<div class="main-container">
    <div class="main">
        <h1>Nuestro Menú Paisa</h1>
        <ul class="pizza-cards">
            @if (platos is not null)
            {
                @foreach (var plato in platos)
                {
                    <li @onclick="@(() => MostrarDialogoPersonalizar(plato))" style="background-image: url('@plato.ImageUrl')">
                        <div class="pizza-info">
                            <span class="title">@plato.Name</span>
                            @plato.Description
                            <span class="price">@plato.GetFormattedBasePrice()</span>
                        </div>
                    </li>
                }
            }
            else
            {
                <p>Cargando menú...</p>
            }
        </ul>
    </div>

    <div class="sidebar">
        @if (pedido.Platos.Any())
        {
            <div class="order-contents">
                <h2>Tu pedido</h2>
                @foreach (var platoConfigurado in pedido.Platos)
                {
                    <div class="cart-item">
                        <a @onclick="@(() => EliminarPlatoDelPedido(platoConfigurado))" class="delete-item">x</a>
                        <div class="title">@platoConfigurado.PlatoBase?.Name (@(platoConfigurado.Tamano == 1 ? "Personal" : (platoConfigurado.Tamano == 2 ? "Doble" : "Para compartir")))</div>
                        <ul>
                            @foreach (var adicion in platoConfigurado.Adiciones)
                            {
                                <li>+ @adicion.Name</li>
                            }
                        </ul>
                        <div class="item-price">
                            @platoConfigurado.GetFormattedTotalPrice()
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-cart">Elige un plato<br>para empezar</div>
        }

        <div class="order-total @(pedido.Platos.Any() ? "" : "hidden")">
            Total:
            <span class="total-price">@pedido.GetFormattedTotalPrice()</span>
            <button class="btn btn-warning" disabled="@(pedido.Platos.Count == 0)" @onclick="RealizarPedido">
                Ordenar >
            </button>
        </div>
    </div>
</div>


@if (mostrandoDialogo)
{
    <DialogoPersonalizarPlato Plato="platoEnConfiguracion!"
                              OnCancel="CancelarPersonalizacion"
                              OnConfirm="ConfirmarPersonalizacion" />
