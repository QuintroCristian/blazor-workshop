@inherits LayoutComponentBase

<div class="top-bar">
    <a class="logo" href="">
        <img src="img/logo-paisa.svg" />
    </a>

    <NavLink href="" class="nav-tab" Match="NavLinkMatch.All">
        <img src="img/bandeja.svg" />
        <div>Ver Menú</div>
    </NavLink>
</div>

<div class="content">
